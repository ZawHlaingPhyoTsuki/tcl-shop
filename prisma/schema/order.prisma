enum OrderStatus {
    PENDING
    CONFIRMED
    DELIVERED
    CANCELLED
}

enum PaymentStatus {
    UNPAID
    PAID
}

model Order {
    id                 String        @id @default(cuid())
    // Human-readable reference for guests and merchants, e.g. "A7K2Q9".
    code               String        @unique
    customerName       String
    customerPhone      String
    deliveryAddress    String
    deliveryNote       String?
    customerNote       String? // Customer's special instructions
    merchantNote       String? // Merchant's internal notes
    subtotal           Int
    deliveryFee        Int           @default(0)
    total              Int
    cancellationReason String?
    cancelledAt        DateTime?
    // Snapshot of Shop.currency at checkout.
    currency           Currency
    status             OrderStatus   @default(PENDING)
    paymentStatus      PaymentStatus @default(UNPAID)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    shopId String
    shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)
    userId String
    user   User   @relation("OrderCustomer", fields: [userId], references: [id])

    items OrderItem[]

    @@index([shopId, status])
    @@index([userId])
    @@index([createdAt])
    // "order" is a reserved SQL word.
    @@map("shop_order")
}

model OrderItem {
    id           String   @id @default(cuid())
    // Snapshots: later listing edits must not rewrite order history.
    productName  String
    variantLabel String?
    unitPrice    Int
    quantity     Int
    lineTotal    Int
    createdAt    DateTime @default(now())

    orderId   String
    order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
    productId String?
    product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
    variantId String?
    variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

    @@index([orderId])
    @@index([productId])
    @@index([variantId])
    @@map("order_item")
}
